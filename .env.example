# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://licrzfncznvsgcoduyjo.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Clé « service_role » (Supabase > Project Settings > API) — serveur uniquement, jamais exposée
SUPABASE_SERVICE_ROLE_KEY=

# Secrets de l'application (générer avec : openssl rand -base64 32)
APP_ENCRYPTION_KEY=          # chiffre les clés API stockées en base (AES-256-GCM)
APP_SIGNING_SECRET=          # signe les sessions votants et hache les numéros

# URL publique du site
NEXT_PUBLIC_SITE_URL=https://vote.aitech-ci.com

# Les clés Resend, Kkiapay et Kapso se saisissent dans le back-office (Admin > Clés API),
# pas dans ce fichier.
